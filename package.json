{
  "name": "@prism/roofing-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "api": "PRISM_ACCESS_MODE=local tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "turbo run build",
    "test:browser": "playwright test",
    "cdk:synth": "tsx infra/cdk/app.ts && tsx scripts/verify-cloud-template.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "contract:check": "tsx scripts/sync-contract.ts --check",
    "contract:sync": "tsx scripts/sync-contract.ts",
    "lambda:package": "tsx scripts/package-lambda.ts",
    "lambda:emulate": "tsx scripts/emulate-lambda.ts",
    "deploy": "tsx scripts/review-ops.ts deploy",
    "smoke": "tsx scripts/review-ops.ts smoke",
    "evidence": "tsx scripts/review-ops.ts evidence",
    "rotate-access": "tsx scripts/review-ops.ts rotate-access",
    "destroy": "tsx scripts/review-ops.ts destroy",
    "campaign": "tsx scripts/model-campaign.ts",
    "test:map-browser": "playwright test --config playwright.map.config.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.34",
    "@aws-sdk/client-bedrock-runtime": "3.1157.0",
    "@aws-sdk/client-dynamodb": "3.1157.0",
    "@aws-sdk/client-secrets-manager": "3.1157.0",
    "@aws-sdk/lib-dynamodb": "3.1157.0",
    "@duckdb/node-api": "2.0.0-r.1",
    "ai": "7.0.154",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "aws-cdk": "2.1146.1",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
