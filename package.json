{
  "name": "roofing-crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @roofing/web e2e",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "fixtures:generate": "tsx fixtures/dataset/generate.ts",
    "fixtures:corpus": "tsx fixtures/rag/build-corpus.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@roofing/rag": "workspace:*",
    "@roofing/shared": "workspace:*",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "zod": "3.25.76"
  }
}
