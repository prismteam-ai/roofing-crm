{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "env": ["OPENAI_API_KEY", "PIPELINE_MCP_URL", "MCP_HTTP_AUTH_TOKEN"]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
