# Copy to .env (gitignored, never committed) and fill in your own values.
# Used only by `make worker-*` targets to authenticate wrangler headlessly.
#
# Create at: https://dash.cloudflare.com/profile/api-tokens
# -> Create Token -> "Edit Cloudflare Workers" template
CLOUDFLARE_API_TOKEN=

# Only needed if `make worker-whoami` reports an ambiguous account.
# Find it in the Cloudflare dashboard, right sidebar of the Overview page.
CLOUDFLARE_ACCOUNT_ID=
