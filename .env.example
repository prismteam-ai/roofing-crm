# OpenAI key used by the RAG agent (Vercel AI SDK, gpt-4.1-mini + text-embedding-3-small).
# Leave empty to run the agent in deterministic offline mode.
OPENAI_API_KEY=sk-...
# Pipeline MCP endpoint (streamable HTTP). Leave empty to use the committed fixture dataset.
PIPELINE_MCP_URL=https://cook-il.example.nip.io/mcp
MCP_HTTP_AUTH_TOKEN=change-me
# Optional
PORT=8080
LEADS_DB_PATH=data/leads.sqlite
TRACE_DIR=data/traces
LOG_LEVEL=info
