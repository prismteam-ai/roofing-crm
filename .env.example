# Oracle (the CRM reads only its HTTP API and MCP, pinned to one published run).
# Local development: in the Oracle repo run
#   ./bin/oracle.mjs serve --fixture fixtures/elephant-mini        (fixture, port 4317)
#   ./bin/oracle.mjs serve --manifest <run 2 manifest CID>         (published county data, M4)
# and set ORACLE_MANIFEST_CID to the CID that server reports at /api/health.
ORACLE_API_URL=http://localhost:4317
ORACLE_MCP_URL=http://localhost:4317/mcp
ORACLE_MANIFEST_CID=

# Agent (local development only; hosted reads the key from SSM Parameter Store)
ANTHROPIC_API_KEY=
CRM_AGENT_MODEL=claude-opus-5-5
AGENT_DAILY_TOKEN_BUDGET=2000000
RATE_LIMIT_PER_MINUTE=10

# Leads (DynamoDB Local in development: docker run -p 8001:8000 amazon/dynamodb-local:2.5.4)
LEADS_TABLE=roofing-crm-leads
DYNAMODB_ENDPOINT=http://localhost:8001
