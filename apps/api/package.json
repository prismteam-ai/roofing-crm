{
  "name": "@roofing-crm-challenge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "tRPC Lambda + CDK (us-east-2; API Gateway execute-api URL, no custom domain).",
  "exports": {
    ".": {
      "types": "./src/handler.ts",
      "default": "./src/handler.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/local-dev-server.ts",
    "lint": "eslint src scripts cdk",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rag:seed-local": "tsx scripts/seed-local-opensearch.ts",
    "rag:stage-demo-corpus": "tsx scripts/stage-chester-demo-corpus.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^3.0.119",
    "ai": "^5.0.0",
    "@aws-lambda-powertools/logger": "^2.14.0",
    "@aws-lambda-powertools/metrics": "^2.14.0",
    "@aws-lambda-powertools/tracer": "^2.14.0",
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/credential-provider-node": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "@elephant-xyz/mcp": "github:elephant-xyz/elephant-mcp#main",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "@roofing-crm-challenge/elephant-client": "workspace:*",
    "@roofing-crm-challenge/shared": "workspace:*",
    "@trpc/server": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.10.0",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
