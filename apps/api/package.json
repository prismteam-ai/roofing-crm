{
  "name": "@roofing-crm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/routers/index.ts",
  "types": "./src/routers/index.ts",
  "exports": {
    ".": "./src/routers/index.ts"
  },
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/handler.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "dev": "tsx watch src/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src cdk",
    "cdk": "cdk"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.147",
    "@ai-sdk/anthropic": "^4.0.108",
    "@aws-lambda-powertools/logger": "^2.11.0",
    "@aws-lambda-powertools/metrics": "^2.11.0",
    "@aws-lambda-powertools/tracer": "^2.11.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.1177.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@roofing-crm/shared": "workspace:*",
    "@trpc/server": "^11.0.0",
    "ai": "^7.0.181",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@roofing-crm/tsconfig": "workspace:*",
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.173.0",
    "aws-cdk-lib": "^2.173.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
